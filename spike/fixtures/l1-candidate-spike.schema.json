{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidates"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "statement", "evidence"],
        "properties": {
          "type": { "type": "string", "const": "concept" },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quote", "prefix", "suffix"],
              "properties": {
                "quote": { "type": "string" },
                "prefix": { "type": "string" },
                "suffix": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
