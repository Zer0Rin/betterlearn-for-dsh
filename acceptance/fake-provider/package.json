{
  "name": "@nobei/dsh-phase1c-fake-provider",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pack:acceptance": "pnpm build && pnpm pack --pack-destination ../../dist"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7 || 0.1.0-rc.8"
  }
}
